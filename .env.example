# ============================================================
# APPLICATION
# ============================================================

# Режим приложения:
# development | production
APP_ENV=production

# Название приложения
APP_NAME=telegram-shop-bot

# Часовой пояс приложения
TIMEZONE=Europe/Berlin

# Язык по умолчанию
DEFAULT_LANGUAGE=ru

# Лог-уровень:
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Директория для логов
LOG_DIR=./logs

# Директория для резервных копий
BACKUP_DIR=./backups


# ============================================================
# TELEGRAM
# ============================================================

# Получить у @BotFather
BOT_TOKEN=CHANGE_ME

# Telegram ID первоначального администратора.
# Несколько ID указываются через запятую:
# ADMIN_IDS=123456789,987654321
ADMIN_IDS=CHANGE_ME

# Username бота без @, используется в некоторых ссылках
BOT_USERNAME=

# Если Telegram API недоступен напрямую:
# http://127.0.0.1:8080
# socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# Таймаут запросов к Telegram API
TELEGRAM_REQUEST_TIMEOUT=30


# ============================================================
# DATABASE
# ============================================================

# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Для PostgreSQL впоследствии:
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/shop

# Показывать SQL-запросы в логах
DATABASE_ECHO=false

# Размер пула соединений PostgreSQL.
# Для SQLite эти параметры фактически не используются.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800


# ============================================================
# CRYPTOPAY / CRYPTOBOT
# ============================================================

# CryptoPay API token от @CryptoBot
CRYPTOPAY_API_TOKEN=

# API base URL
CRYPTOPAY_API_URL=https://pay.crypt.bot/api

# Включить CryptoPay
CRYPTOPAY_ENABLED=true

# Приоритет шлюза.
# Чем меньше число — тем выше приоритет.
CRYPTOPAY_PRIORITY=1

# Webhook secret/token.
# Конкретная схема проверки будет реализована в crypto_pay.py
CRYPTOPAY_WEBHOOK_SECRET=

# Максимальный возраст invoice:
# 30 минут = 1800 секунд
INVOICE_TTL_SECONDS=1800

# Интервал polling незавершённых invoice
INVOICE_POLL_INTERVAL_SECONDS=15

# Ограничение создания invoice:
# один пользователь не чаще одного раза в 30 секунд
INVOICE_RATE_LIMIT_SECONDS=30


# ============================================================
# NOWPAYMENTS
# ============================================================

# API key NOWPayments
NOWPAYMENTS_API_KEY=

# IPN secret
NOWPAYMENTS_IPN_SECRET=

# API URL
NOWPAYMENTS_API_URL=https://api.nowpayments.io

# Включение резервного шлюза
NOWPAYMENTS_ENABLED=false

# Приоритет
NOWPAYMENTS_PRIORITY=2


# ============================================================
# SUPPORTED CRYPTOCURRENCIES
# ============================================================

# Список валют, разрешённых для оплаты.
# Проверка будет выполняться на уровне сервисов.
SUPPORTED_CURRENCIES=USDTTRC20,USDTTON,TON,BTC,ETH


# ============================================================
# PROXY
# ============================================================

# Глобальный proxy для внешних HTTP-запросов.
#
# Примеры:
# http://127.0.0.1:8080
# http://user:password@127.0.0.1:8080
# socks5://127.0.0.1:1080
# socks5://user:password@127.0.0.1:1080
GLOBAL_PROXY_URL=

# Использовать proxy для Crypto API
CRYPTO_PROXY_ENABLED=true

# Использовать GLOBAL_PROXY_URL для Telegram API,
# если TELEGRAM_PROXY_URL не указан
USE_GLOBAL_PROXY_FOR_TELEGRAM=false

# Файл с пулом прокси.
# Каждая строка:
# http://...
# socks5://...
PROXY_POOL_FILE=./proxies.txt

# Включить ротацию proxy
PROXY_ROTATION_ENABLED=false

# Таймаут проверки proxy
PROXY_HEALTHCHECK_TIMEOUT=10

# Сколько ошибок подряд считать proxy нерабочим
PROXY_FAILURE_THRESHOLD=3

# Коды, при которых разрешается переключение proxy
PROXY_ROTATE_ON_STATUS_CODES=403,429


# ============================================================
# HTTP
# ============================================================

HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30
HTTP_POOL_TIMEOUT=10

# Максимальное количество одновременных внешних HTTP-запросов
HTTP_MAX_CONNECTIONS=50

# Максимальное количество соединений к одному host
HTTP_MAX_KEEPALIVE_CONNECTIONS=20


# ============================================================
# SHOP
# ============================================================

# Минимальная сумма пополнения баланса USD.
# Реальное значение также хранится в БД и может быть изменено
# администратором через Telegram.
DEFAULT_MIN_TOPUP_USD=5.00

# Валюта внутренних цен
SHOP_CURRENCY=USD

# Сколько знаков после запятой хранить/показывать для USD
MONEY_DECIMAL_PLACES=2

# Включить продажу
SHOP_ENABLED=true

# Технические работы
MAINTENANCE_MODE=false

# Проверять подписку на канал перед покупкой
SUBSCRIPTION_REQUIRED=false

# ID канала.
# Для приватного канала указывается numeric ID.
REQUIRED_CHANNEL_ID=

# Username канала без @, если используется публичный канал
REQUIRED_CHANNEL_USERNAME=


# ============================================================
# CURRENCY / RATES
# ============================================================

# URL источника курса.
# Реальная реализация будет вынесена в отдельный сервис.
EXCHANGE_RATE_API_URL=

# API key курса, если требуется
EXCHANGE_RATE_API_KEY=

# Резервный курс USD/RUB.
# Используется только если внешний источник недоступен.
DEFAULT_USD_RUB_RATE=100.00

# Максимальный возраст курса в секундах,
# после которого курс считается устаревшим.
EXCHANGE_RATE_MAX_AGE_SECONDS=900


# ============================================================
# REFERRALS
# ============================================================

# Включить реферальную систему
REFERRALS_ENABLED=true

# Процент от покупок приглашённых.
# Например 5 = 5%.
DEFAULT_REFERRAL_PERCENT=5.00

# Минимальная сумма покупки, с которой начисляется referral reward
REFERRAL_MIN_ORDER_USD=1.00


# ============================================================
# BROADCAST
# ============================================================

# Максимальное количество сообщений рассылки в секунду.
# Реальный throttling будет дополнительно учитывать Telegram limits.
BROADCAST_MESSAGES_PER_SECOND=20

# Размер batch при массовой рассылке
BROADCAST_BATCH_SIZE=20

# Пауза между batch
BROADCAST_BATCH_DELAY_SECONDS=1


# ============================================================
# ANTI-FLOOD
# ============================================================

# Общее количество действий пользователя за окно
THROTTLE_RATE=5

# Размер окна throttling
THROTTLE_PERIOD_SECONDS=2

# Сколько секунд блокировать после превышения
THROTTLE_BLOCK_SECONDS=10


# ============================================================
# BACKUPS
# ============================================================

# Включить автоматический backup
BACKUP_ENABLED=true

# Cron/интервал backup будет задаваться APScheduler.
# Значения по умолчанию:
BACKUP_INTERVAL_HOURS=24

# Хранить backups N дней
BACKUP_RETENTION_DAYS=14

# Разрешить скачивание backup администратором через Telegram
BACKUP_DOWNLOAD_ENABLED=true


# ============================================================
# CLEANUP
# ============================================================

# Удалять старые invoice
INVOICE_CLEANUP_ENABLED=true

# Удалять invoice старше N часов
INVOICE_CLEANUP_HOURS=24

# Интервал запуска cleanup
CLEANUP_INTERVAL_MINUTES=60


# ============================================================
# HEALTHCHECK
# ============================================================

# HTTP host
HEALTHCHECK_HOST=127.0.0.1

# HTTP port
HEALTHCHECK_PORT=8080

# URL endpoint:
# http://127.0.0.1:8080/health
HEALTHCHECK_PATH=/health


# ============================================================
# P2P GUIDE
# ============================================================

# Показывать P2P-гайд
P2P_GUIDE_ENABLED=true

# Username поддержки без @
SUPPORT_USERNAME=

# URL поддержки.
# Например:
# https://t.me/example_support
SUPPORT_URL=

# Можно будет также хранить текст/фото гайда в БД.
# Эти значения являются только начальными.
P2P_GUIDE_TITLE_RU=Как пополнить баланс
P2P_GUIDE_TITLE_EN=How to top up your balance


# ============================================================
# ADMIN NOTIFICATIONS
# ============================================================

# Отправлять администраторам уведомления
ADMIN_NOTIFICATIONS_ENABLED=true

# Уведомлять о новом заказе
NOTIFY_NEW_ORDER=true

# Уведомлять об оплате
NOTIFY_PAYMENT=true

# Уведомлять об ошибках
NOTIFY_ERRORS=true

# Уведомлять о критических ошибках шлюза
NOTIFY_GATEWAY_ERRORS=true


# ============================================================
# CSV EXPORT
# ============================================================

# Кодировка CSV
CSV_ENCODING=utf-8-sig

# Разделитель CSV
CSV_DELIMITER=;


# ============================================================
# LOCALIZATION
# ============================================================

# Директория переводов
LOCALES_DIR=./locales

# Поддерживаемые языки
SUPPORTED_LANGUAGES=ru,en


# ============================================================
# SECURITY
# ============================================================

# Максимальная длина пользовательского текста
MAX_TEXT_LENGTH=4000

# Максимальный размер описания товара
MAX_PRODUCT_DESCRIPTION_LENGTH=10000

# Максимальный размер имени товара
MAX_PRODUCT_NAME_LENGTH=255

# Максимальный размер названия категории
MAX_CATEGORY_NAME_LENGTH=255

# Максимальный размер промокода
MAX_PROMO_CODE_LENGTH=64

# Разрешить HTML в описаниях товаров
ALLOW_HTML_IN_PRODUCT_DESCRIPTION=false

# Секрет для внутренних операций приложения.
# Не использовать BOT_TOKEN.
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_LONG_SECRET


# ============================================================
# LOGGING
# ============================================================

# Максимальный размер одного log-файла
LOG_ROTATION=10 MB

# Хранить логи
LOG_RETENTION=30 days

# Сжимать старые логи
LOG_COMPRESSION=zip

# Логировать traceback
LOG_BACKTRACE=true

# Диагностический режим loguru
LOG_DIAGNOSE=false